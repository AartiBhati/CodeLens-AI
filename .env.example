# --- App ---
ENV=development
DEBUG=false
JWT_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens
POSTGRES_DB=codelens

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL_SECONDS=1800
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=codelens-indexing-workers

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=repository_embeddings

# --- GitHub ---
# Personal access token, needed only for private repositories.
GITHUB_TOKEN=
GITHUB_CLONE_DIR=/tmp/codelens-repos

# --- LLM Provider (huggingface | openai | gemini) ---
# Default: Hugging Face (free). EMBEDDING_DIM must match the embedding model
# (BAAI/bge-small-en-v1.5 = 384). If you change the embedding model after
# indexing, delete the Qdrant collection and re-index.
LLM_PROVIDER=huggingface
EMBEDDING_DIM=384

# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
HF_CHAT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HF_CHAT_MAX_TOKENS=1024
# local = sentence-transformers inside the container (no quota); api = HF Inference API
HF_EMBEDDING_MODE=local
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Alternative providers (uncomment one block; set EMBEDDING_DIM accordingly) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key
# GEMINI_CHAT_MODEL=gemini-1.5-flash
# EMBEDDING_DIM=768
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- RAG tuning ---
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=8
MAX_HISTORY_MESSAGES=12
HISTORY_SUMMARY_TRIGGER=20
